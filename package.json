{
  "name": "dsh-fleet",
  "version": "0.1.0",
  "description": "Agent legion for DeepSeek Harness: hand a client's direction to the chat, and the model dispatches opencode / hermes / claude / codex workers in parallel, watches their deadlines, and collects their deliverables.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "lib",
    "locale",
    "scripts",
    "cordis.patch.yml",
    "icon.svg",
    "README.md"
  ],
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node scripts/selftest.mjs",
    "selftest": "node scripts/selftest.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "multi-agent",
    "orchestration",
    "opencode",
    "hermes",
    "sapper"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
